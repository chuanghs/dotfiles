#!/usr/bin/env bash

# Find the directory where this script is located
BIN_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
PROJECT_ROOT="$( dirname "$BIN_DIR" )"
PYTHON_SCRIPT="$PROJECT_ROOT/src/python/clean_maven_cache.py"
VENV_PATH="$PROJECT_ROOT/.venv"

# Check if venv exists
if [ ! -d "$VENV_PATH" ]; then
    echo "Error: Virtual environment not found at $VENV_PATH."
    echo "Run 'python3 -m venv $VENV_PATH' to create it."
    exit 1
fi

# Activate virtual environment
source "$VENV_PATH/bin/activate"

# Ensure deactivation on exit (trap works for both normal exit and signals)
trap "deactivate 2>/dev/null" EXIT

# Run the python script with all passed arguments
python3 "$PYTHON_SCRIPT" "$@"
